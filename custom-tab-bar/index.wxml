<view class="custom-tabbar {{hidden ? 'is-hidden' : ''}}"><view wx:for="{{list}}" wx:key="pagePath" data-index="{{index}}" data-path="{{item.pagePath}}" bindtap="switchTab" class="tab-item {{index === 2 ? 'voice-item' : ''}} {{selected === index ? 'tab-selected' : ''}}"><view class="icon-box"><block wx:if="{{index === 2}}"><view class="voice-disc"><view class="voice-wave"><view class="wave-bar b1"></view><view class="wave-bar b2"></view><view class="wave-bar b3"></view><view class="wave-bar b4"></view><view class="wave-bar b5"></view></view></view></block><image wx:else class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit"/></view><text class="tab-label">{{item.text}}</text></view></view>
