.state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 48rpx; }
.state-title { font-size: 28rpx; color: #3a403d; }
.state-desc { margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; color: #8b928e; text-align: center; }

.item { display: block; margin-bottom: 20rpx; padding: 26rpx; }
.item-head { display: flex; align-items: baseline; justify-content: space-between; }
.item-q { flex: 1; min-width: 0; margin-right: 16rpx; font-size: 28rpx; font-weight: 600; color: #1c1e1d; }
.item-time { flex: none; font-size: 20rpx; color: #a2a8a4; }
.item-a { display: block; margin-top: 12rpx; font-size: 24rpx; line-height: 1.65; color: #5c6460; }

.clear-row { padding: 20rpx 0 40rpx; text-align: center; }
.clear-btn { font-size: 23rpx; color: #b0b6b1; }
