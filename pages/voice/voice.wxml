<view class="page voice">
  <view class="page-head">
    <text class="page-title">语音问答</text>
    <text class="page-sub">长按麦克风说话，松开自动识别 · AI 回答</text>
  </view>

  <view class="tabs">
    <view class="tab {{activeTab === 'voice' ? 'tab-on' : ''}}" data-tab="voice" bindtap="switchMode">语音</view>
    <view class="tab {{activeTab === 'text' ? 'tab-on' : ''}}" data-tab="text" bindtap="switchMode">文字</view>
  </view>

  <!-- 语音模式：只放麦克风 -->
  <block wx:if="{{activeTab === 'voice'}}">
    <view class="mic card {{recording ? 'mic-active' : ''}}">
      <view class="mic-btn" bindtouchstart="onVoiceStart" bindtouchend="onVoiceEnd" bindtouchcancel="onVoiceCancel">
        <view class="wave-lg">
          <view class="wbar w1"></view><view class="wbar w2"></view><view class="wbar w3"></view><view class="wbar w4"></view><view class="wbar w5"></view>
        </view>
      </view>
      <text class="mic-title">{{voiceTitle}}</text>
      <text class="mic-hint">{{voiceHint}}</text>
    </view>

    <view class="switch-tip" data-tab="text" bindtap="switchMode">
      <text class="switch-tip-text">不方便说话？切换到文字输入</text>
      <text class="chev">›</text>
    </view>
  </block>

  <!-- 文字模式：示例 + 输入框 -->
  <block wx:else>
    <view class="ask card">
      <text class="ask-label">你可以这样问</text>
      <view class="chips">
        <text class="chip" bindtap="fillLibrary">图书馆开放时间</text>
        <text class="chip" bindtap="fillCourse">今天有什么课</text>
        <text class="chip" bindtap="fillCanteen">食堂推荐</text>
      </view>
      <view class="input-row">
        <input
          class="input-field"
          value="{{question}}"
          focus="{{inputFocus}}"
          bindinput="onInput"
          placeholder="输入你的校园问题"
          placeholder-class="ph"
          confirm-type="send"
          bindconfirm="submit"
        />
        <button class="send" bindtap="submit">发送</button>
      </view>
    </view>
  </block>

  <view wx:if="{{showResult}}" id="answer" class="answer card">
    <view class="answer-head">
      <text class="answer-label">校园助手</text>
      <text wx:if="{{sourceLabel}}" class="answer-source {{source === 'ai' ? 'src-ai' : ''}}">{{sourceLabel}}</text>
    </view>

    <view wx:if="{{thinking}}" class="thinking">
      <view class="dot d1"></view>
      <view class="dot d2"></view>
      <view class="dot d3"></view>
      <text class="thinking-text">正在思考…</text>
    </view>

    <text wx:else class="answer-text">{{resultText}}</text>

    <text wx:if="{{degraded}}" class="degraded-tip">AI 暂时不可用，以上由本地知识库回答</text>
  </view>

  <text class="footnote">AI 生成内容仅供参考 · 具体以学校最新通知为准</text>
</view>
