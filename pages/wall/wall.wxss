.wall-page { min-height: 100vh; background: #fff; }
.wall-top-area { padding: 28rpx 32rpx 0; background: #f2f2ee; }

.wall-top { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 24rpx; }
.wall-head { display: flex; flex-direction: column; }
.publish { display: flex; flex: none; align-items: center; justify-content: center; height: 64rpx; margin-top: 10rpx; padding: 0 24rpx; border-radius: 10rpx; background: #1f6b5e; color: #fff; font-size: 24rpx; }

.search { display: flex; align-items: center; height: 76rpx; padding: 0 18rpx; background: #fff; border: 1rpx solid #e4e5df; border-radius: 12rpx; }
.search-icon { position: relative; flex: none; width: 24rpx; height: 24rpx; margin-right: 14rpx; border: 3rpx solid #7b837f; border-radius: 50%; }
.search-icon:after { content: ""; position: absolute; right: -8rpx; bottom: -2rpx; width: 9rpx; height: 3rpx; border-radius: 2rpx; background: #7b837f; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 76rpx; font-size: 26rpx; color: #1c1e1d; }
.clear { flex: none; padding-left: 16rpx; font-size: 22rpx; color: #1f6b5e; }

.cats { width: 100%; height: 88rpx; margin-top: 8rpx; white-space: nowrap; }
.cat { display: inline-block; padding: 20rpx 0 16rpx; margin-right: 40rpx; font-size: 26rpx; color: #6c7571; }
.cat-on { color: #1c1e1d; font-weight: 600; border-bottom: 4rpx solid #1f6b5e; }

.feed { padding-bottom: calc(208rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e4e5df; }
.feed-head { display: flex; align-items: baseline; justify-content: space-between; padding: 26rpx 32rpx 10rpx; }
.feed-title { font-size: 30rpx; font-weight: 600; color: #1c1e1d; }
.feed-count { font-size: 21rpx; color: #9aa09c; }

.post { padding: 24rpx 32rpx 20rpx; border-top: 1rpx solid #eef0ea; }
.post-head { display: flex; align-items: center; }
.avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 14rpx; background: #eef0ea; color: #535b57; font-size: 26rpx; font-weight: 600; }
.avatar.blue { background: #eaeef4; color: #4a5c74; }
.avatar.amber { background: #f5eee3; color: #7a6240; }
.post-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; margin-left: 16rpx; }
.post-name-row { display: flex; align-items: center; }
.post-name { font-size: 26rpx; font-weight: 600; color: #1c1e1d; }
.mine-tag { margin-left: 10rpx; padding: 0 8rpx; border-radius: 6rpx; background: #e6f0ed; color: #1f6b5e; font-size: 18rpx; line-height: 30rpx; }
.post-time { margin-top: 2rpx; font-size: 21rpx; color: #9aa09c; }
.post-content { display: block; margin-top: 16rpx; font-size: 28rpx; line-height: 1.65; color: #2a302e; }
.post-actions { display: flex; align-items: center; margin-top: 18rpx; }
.act { margin-right: 40rpx; font-size: 23rpx; color: #6c7571; }
.act-on { color: #1f6b5e; }
.act-tip { margin-left: auto; font-size: 20rpx; color: #b4b9b5; }
.detail { margin-left: auto; font-size: 23rpx; color: #9aa09c; }

/* ---------- 点赞（爱心图标） ---------- */
.act-like { display: flex; align-items: center; margin-right: 40rpx; }
.like-icon { width: 34rpx; height: 34rpx; margin-right: 8rpx; }
.like-count { font-size: 23rpx; color: #6c7571; }
.act-like.is-liked .like-count { color: #f5455c; }

/* ---------- 空状态 / 错误状态 ---------- */
.state { display: flex; flex-direction: column; align-items: center; padding: 90rpx 48rpx; }
.state-title { font-size: 28rpx; color: #3a403d; }
.state-desc { margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; color: #8b928e; text-align: center; }
.state-btn { margin-top: 28rpx; padding: 14rpx 40rpx; border: 1rpx solid #1f6b5e; border-radius: 10rpx; color: #1f6b5e; font-size: 24rpx; }

/* ---------- 骨架屏 ---------- */
.skeleton { padding: 10rpx 0; }
.sk-row { display: flex; padding: 26rpx 32rpx; border-top: 1rpx solid #eef0ea; }
.sk-avatar { flex: none; width: 72rpx; height: 72rpx; border-radius: 14rpx; background: #f0f1ec; }
.sk-lines { flex: 1; margin-left: 16rpx; }
.sk-line { height: 20rpx; margin-bottom: 14rpx; border-radius: 6rpx; background: #f0f1ec; }
.sk-w30 { width: 30%; }
.sk-w60 { width: 60%; }
.sk-w90 { width: 90%; }

/* ---------- 底部加载提示 ---------- */
.footer { padding: 30rpx 0 40rpx; text-align: center; font-size: 22rpx; color: #a2a8a4; }

/* ---------- 发布面板 ---------- */
/*
 * 注意 z-index：自定义 tabBar 用的是 999（见 custom-tab-bar/index.wxss），
 * 任何盖在页面上的浮层都必须比它大，否则会被底部导航栏压住。
 */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, 0.38); z-index: 1000; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 1001;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}
.sheet-bar { width: 64rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 4rpx; background: #e0e2dc; }
.sheet-head { display: flex; align-items: baseline; justify-content: space-between; }
.sheet-title { font-size: 30rpx; font-weight: 600; color: #1c1e1d; }
.sheet-count { font-size: 21rpx; color: #9aa09c; }
.sheet-input { width: 100%; min-height: 180rpx; margin-top: 20rpx; padding: 20rpx; background: #f6f7f3; border-radius: 12rpx; font-size: 27rpx; line-height: 1.6; box-sizing: border-box; }
.sheet-cats { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.sheet-cat { margin: 0 16rpx 16rpx 0; padding: 10rpx 24rpx; border-radius: 30rpx; background: #f2f3ef; font-size: 23rpx; color: #5c6460; }
.sheet-cat-on { background: #1f6b5e; color: #fff; }
.sheet-actions { display: flex; margin-top: 12rpx; }
.sheet-btn { flex: 1; height: 84rpx; line-height: 84rpx; border-radius: 12rpx; text-align: center; font-size: 28rpx; }
.sheet-btn + .sheet-btn { margin-left: 20rpx; }
.sheet-btn.ghost { background: #f4f5f1; color: #5c6460; }
.sheet-btn.primary { background: #1f6b5e; color: #fff; }
.sheet-btn.is-disabled { opacity: 0.5; }
