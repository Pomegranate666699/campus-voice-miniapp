.wall-page { min-height: 100vh; background: #fff; }
.wall-top-area { padding: 28rpx 32rpx 0; background: #f2f2ee; }

.wall-top { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 24rpx; }
.wall-head { display: flex; flex-direction: column; }
.publish { display: flex; flex: none; align-items: center; justify-content: center; height: 64rpx; margin-top: 10rpx; padding: 0 24rpx; border-radius: 10rpx; background: #1f6b5e; color: #fff; font-size: 24rpx; }

.search { display: flex; align-items: center; height: 76rpx; padding: 0 18rpx; background: #fff; border: 1rpx solid #e4e5df; border-radius: 12rpx; }
.search-icon { position: relative; flex: none; width: 24rpx; height: 24rpx; margin-right: 14rpx; border: 3rpx solid #7b837f; border-radius: 50%; }
.search-icon:after { content: ""; position: absolute; right: -8rpx; bottom: -2rpx; width: 9rpx; height: 3rpx; border-radius: 2rpx; background: #7b837f; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 76rpx; font-size: 26rpx; color: #1c1e1d; }
.clear { flex: none; padding-left: 16rpx; font-size: 22rpx; color: #1f6b5e; }

.cats { width: 100%; height: 88rpx; margin-top: 8rpx; white-space: nowrap; }
.cat { display: inline-block; padding: 20rpx 0 16rpx; margin-right: 40rpx; font-size: 26rpx; color: #6c7571; }
.cat-on { color: #1c1e1d; font-weight: 600; border-bottom: 4rpx solid #1f6b5e; }

.feed { padding-bottom: calc(208rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e4e5df; }
.feed-head { display: flex; align-items: baseline; justify-content: space-between; padding: 26rpx 32rpx 10rpx; }
.feed-title { font-size: 30rpx; font-weight: 600; color: #1c1e1d; }
.feed-count { font-size: 21rpx; color: #9aa09c; }

.post { padding: 24rpx 32rpx 20rpx; border-top: 1rpx solid #eef0ea; }
.post-head { display: flex; align-items: center; }
.avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 14rpx; background: #eef0ea; color: #535b57; font-size: 26rpx; font-weight: 600; }
.avatar.blue { background: #eaeef4; color: #4a5c74; }
.avatar.amber { background: #f5eee3; color: #7a6240; }
.post-meta { display: flex; flex-direction: column; margin-left: 16rpx; }
.post-name { font-size: 26rpx; font-weight: 600; color: #1c1e1d; }
.post-time { margin-top: 2rpx; font-size: 21rpx; color: #9aa09c; }
.post-content { display: block; margin-top: 16rpx; font-size: 28rpx; line-height: 1.65; color: #2a302e; }
.post-actions { display: flex; align-items: center; margin-top: 18rpx; }
.act { margin-right: 40rpx; font-size: 23rpx; color: #6c7571; }
.act-on { color: #1f6b5e; }
.detail { margin-left: auto; font-size: 23rpx; color: #9aa09c; }

.empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.empty-title { font-size: 27rpx; color: #3a403d; }
.empty-desc { margin-top: 8rpx; font-size: 22rpx; color: #8b928e; }
