.home { background: #f2f2ee; }

.topbar { display: flex; align-items: center; justify-content: space-between; padding-top: 4rpx; }
.brand { display: flex; align-items: center; }
.brand-mark { width: 64rpx; height: 64rpx; border-radius: 14rpx; background: #1f6b5e; color: #fff; font-size: 28rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.brand-text { display: flex; flex-direction: column; margin-left: 16rpx; }
.brand-name { font-size: 30rpx; font-weight: 600; color: #1c1e1d; }
.brand-school { margin-top: 2rpx; font-size: 20rpx; color: #8b928e; }
.avatar { width: 60rpx; height: 60rpx; border-radius: 50%; background: #e2e5e0; color: #535b57; font-size: 24rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }

.greet { display: flex; flex-direction: column; padding: 44rpx 2rpx 26rpx; }
.greet-title { font-size: 42rpx; font-weight: 600; color: #1c1e1d; letter-spacing: -0.4rpx; }
.greet-sub { margin-top: 8rpx; font-size: 23rpx; color: #7d8581; }

.ask { padding: 20rpx 20rpx 6rpx; }
.search { display: flex; align-items: center; height: 80rpx; padding: 0 18rpx; background: #f5f5f1; border-radius: 12rpx; }
.search-icon { position: relative; flex: none; width: 26rpx; height: 26rpx; margin-right: 14rpx; border: 3rpx solid #7b837f; border-radius: 50%; }
.search-icon:after { content: ""; position: absolute; right: -8rpx; bottom: -2rpx; width: 10rpx; height: 3rpx; border-radius: 2rpx; background: #7b837f; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 80rpx; font-size: 26rpx; color: #1c1e1d; }
.search-go { flex: none; padding-left: 18rpx; font-size: 26rpx; font-weight: 500; color: #1f6b5e; }
.ask-divider { height: 1rpx; margin-top: 20rpx; background: #eef0ea; }
.voice-entry { display: flex; align-items: center; height: 86rpx; }
.wave { display: flex; align-items: center; width: 34rpx; height: 32rpx; margin-right: 14rpx; }
.bar { width: 6rpx; border-radius: 3rpx; background: #1f6b5e; }
.bar + .bar { margin-left: 5rpx; }
.b1, .b4 { height: 12rpx; }
.b2 { height: 24rpx; }
.b3 { height: 30rpx; }
.voice-title { font-size: 26rpx; color: #2a302e; }
.voice-desc { margin-left: 12rpx; font-size: 22rpx; color: #8b928e; }
.voice-entry .chev { margin-left: auto; }

.stats { display: flex; margin-top: 20rpx; padding: 22rpx 0; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat + .stat { border-left: 1rpx solid #eef0ea; }
.stat-num { font-size: 38rpx; font-weight: 600; line-height: 1.1; color: #1c1e1d; }
.stat-unit { margin-left: 2rpx; font-size: 20rpx; font-weight: 400; color: #6c7571; }
.stat-label { margin-top: 6rpx; font-size: 21rpx; color: #7d8581; }

.notice { display: flex; align-items: center; margin-top: 20rpx; padding: 22rpx 24rpx; background: #fff; border: 1rpx solid #e4e5df; border-radius: 16rpx; }
.notice-tag { flex: none; padding: 3rpx 8rpx; border-radius: 6rpx; background: #edf3f0; color: #1f6b5e; font-size: 20rpx; }
.notice-text { flex: 1; min-width: 0; margin: 0 14rpx; font-size: 24rpx; color: #333a37; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.notice-date { flex: none; font-size: 21rpx; color: #9aa09c; }

.list { overflow: hidden; }
.row { display: flex; align-items: center; min-height: 96rpx; padding: 18rpx 24rpx; }
.row + .row { border-top: 1rpx solid #eef0ea; }
.row-body { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.row-title { flex: 1; min-width: 0; font-size: 28rpx; color: #2a302e; }
.row-desc { margin-top: 4rpx; font-size: 21rpx; color: #8b928e; }
.row .chev { flex: none; margin-left: 16rpx; }

.footnote { display: block; margin: 32rpx 2rpx 0; font-size: 20rpx; line-height: 1.6; color: #9aa09c; }
