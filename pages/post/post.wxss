.post-page { min-height: 100vh; padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom)); background: #f2f2ee; }

/* ---------- 正文 ---------- */
.detail { padding: 26rpx; }
.detail-head { display: flex; align-items: center; }
.avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 16rpx; background: #eef0ea; color: #535b57; font-size: 28rpx; font-weight: 600; }
.avatar.sm { width: 56rpx; height: 56rpx; border-radius: 12rpx; font-size: 22rpx; }
.avatar.blue { background: #eaeef4; color: #4a5c74; }
.avatar.amber { background: #f5eee3; color: #7a6240; }
.detail-meta { display: flex; flex-direction: column; margin-left: 16rpx; }
.detail-name { font-size: 27rpx; font-weight: 600; color: #1c1e1d; }
.detail-time { margin-top: 4rpx; font-size: 21rpx; color: #9aa09c; }
.detail-content { display: block; margin-top: 20rpx; font-size: 29rpx; line-height: 1.7; color: #2a302e; }
.detail-actions { display: flex; align-items: center; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #eef0ea; }
.act { margin-right: 44rpx; font-size: 24rpx; color: #6c7571; }
.act-on { color: #1f6b5e; }

/* ---------- 评论区 ---------- */
.comments-head { display: flex; align-items: baseline; margin: 34rpx 2rpx 12rpx; }
.comments-title { font-size: 30rpx; font-weight: 600; color: #1c1e1d; }
.comments-count { margin-left: 12rpx; font-size: 21rpx; color: #9aa09c; }

.comment-list { background: #fff; border: 1rpx solid #e4e5df; border-radius: 16rpx; overflow: hidden; }
.comment { display: flex; padding: 24rpx; }
.comment + .comment { border-top: 1rpx solid #eef0ea; }
.comment-body { flex: 1; min-width: 0; margin-left: 16rpx; }
.comment-head { display: flex; align-items: center; }
.comment-name { font-size: 24rpx; font-weight: 600; color: #3a403d; }
.mine-tag { margin-left: 10rpx; padding: 0 8rpx; border-radius: 6rpx; background: #e6f0ed; color: #1f6b5e; font-size: 18rpx; line-height: 30rpx; }
.comment-time { margin-left: auto; font-size: 20rpx; color: #a2a8a4; }
.comment-text { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: #2a302e; }

/* ---------- 状态 ---------- */
.state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 48rpx; }
.state-title { font-size: 28rpx; color: #3a403d; }
.state-desc { margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; color: #8b928e; text-align: center; }
.state-btn { margin-top: 28rpx; padding: 14rpx 40rpx; border: 1rpx solid #1f6b5e; border-radius: 10rpx; color: #1f6b5e; font-size: 24rpx; }
.footer { padding: 26rpx 0; text-align: center; font-size: 22rpx; color: #a2a8a4; background: #fff; }

/* ---------- 底部输入 ---------- */
.composer {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  display: flex; align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #e4e5df;
}
.composer-input { flex: 1; min-width: 0; height: 76rpx; padding: 0 20rpx; background: #f6f7f3; border-radius: 10rpx; font-size: 26rpx; }
.composer-btn { flex: none; margin-left: 16rpx; padding: 0 30rpx; height: 76rpx; line-height: 76rpx; border-radius: 10rpx; background: #1f6b5e; color: #fff; font-size: 26rpx; }
.composer-btn.is-disabled { opacity: 0.5; }
